# Скопіюйте цей файл у .env і впишіть свій ключ.
# Згенерувати ключ:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=впишіть-сюди-свій-секретний-ключ
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# На хостингу: DJANGO_DEBUG=False, адреса сайту в ALLOWED_HOSTS і в CSRF_TRUSTED_ORIGINS (з https://)
DJANGO_CSRF_TRUSTED_ORIGINS=
